  Content-Security-Policy: upgrade-insecure-requests; default-src 'self' data: blob:; script-src 'self' data: blob: 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdnjs.cloudflare.com https://gumroad.com https://assets.gumroad.com; style-src 'self' data: blob: 'unsafe-inline' https://assets.gumroad.com; img-src 'self' data: blob: https:; font-src 'self' data:; frame-src 'self' https:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self';

